<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>3fui-server</AssemblyName>
    <RootNamespace>linux3fui.Server</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Description>linux-3fui 服务端：为 3FUI 核心库提供 Web 前端与 API，运行于 Linux/Docker。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\3fui-core\3fui-core.vbproj" />
  </ItemGroup>

</Project>
