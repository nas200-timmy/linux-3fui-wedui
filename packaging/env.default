# linux-3fui 运行配置（systemd EnvironmentFile）
# 改完执行：sudo systemctl restart linux-3fui
# 查看生效情况：sudo systemctl show linux-3fui -p Environment ; systemctl status linux-3fui

# ★ 媒体库根目录：网页「文件」页只能在这个范围内浏览与入队 —— 必须改成你的媒体库路径
MEDIA_ROOT=/media

# 数据目录：设置(Settings.json)、预设、队列缓存、HTTPS 证书都在这里
# 服务用户 linux-3fui 需要写权限（安装脚本已建好并 chown）
DATA_DIR=/var/lib/linux-3fui

# 监听端口：8080 HTTP（上传证书后自动 301 到 HTTPS）、8443 HTTPS
HTTP_PORT=8080
HTTPS_PORT=8443

# 日志与时间显示用的时区
TZ=Asia/Shanghai

# 声明式 HTTPS（可选）：把证书路径写在这里，优先级高于网页上传
# TLS_CERT_PATH=/etc/ssl/certs/3fui.crt
# TLS_KEY_PATH=/etc/ssl/private/3fui.key
#
# UDP 远程调用端口（与 Windows 版 3FUI 协议一致，默认 10591）
# 由网页「设置」页控制，不在这里配。
